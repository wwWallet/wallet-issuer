{
  "name": "wallet-issuer",
  "version": "1.0.0",
  "main": "src/app.js",
  "author": "wwWallet team",
  "license": "MIT",
  "scripts": {
    "cmd:hs512-keygen": "ts-node cmd/hs512-keygen.ts",
    "cmd:ecdh-keygen": "ts-node cmd/ecdh-keygen.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "build:prod": "rm -rf node_modules && yarn install && yarn build && rm -rf node_modules && yarn install --production",
    "start-debug": "node --inspect=0.0.0.0:9259 -r source-map-support/register dist/src/app.js",
    "start": "node dist/src/app.js",
    "dev": "npx nodemon --config nodemon.json --exec \"npx tsc --outdir dist && yarn start-debug\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@auth0/mdl": "^3.0.1",
    "@sd-jwt/core": "^0.17.0",
    "@sd-jwt/crypto-nodejs": "^0.17.0",
    "@sd-jwt/types": "^0.17.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jose": "^6.1.3",
    "wallet-common": "git+https://github.com/wwWallet/wallet-common.git#d0b67bea564700f587e4b0c57ba1739295d32f7d",
    "winston": "^3.19.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.2",
    "@types/qrcode": "^1.5.6",
    "nodemon": "^3.1.11",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "description": ""
}
