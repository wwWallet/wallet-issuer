extends ./layout.pug

block head-styles
	link(rel="stylesheet" href="/styles/offer.css")

block content
	section.hero
		.container
			h1= locale.home.title
			p.subtitle= locale.home.subtitle

	section.catalog
		.container
			// left: optional text / instructions (or keep empty)
			div
				// you can add a short note here if you want
				// p.muted= locale.offer.hint

			// right: QR + buttons
			.offer-card
				canvas#qr(data-value=credentialOfferWithReference)
				.offer-actions
					a.btn.btn-primary(href=credentialOfferWithReferenceForWwwallet)= locale.offer.openInwwallet
					a.btn.btn-primary(href=credentialOfferWithReference)= locale.offer.openInGenericWallet

	script(src="/js/qr.min.js")
	script(src="/js/qr.js")
