header.site-header
	.container
		.header-inner
			a.brand(href="/")
				img.brand-logo(src=displayLogoUri alt=`${displayName} logo`)
				.brand-texts
					span.brand-title #{displayName}

			nav.site-nav
				a(href="/" class=currentPath === "/" ? "is-active" : "")= locale.nav.home
				a(href="/about" class=currentPath === "/about" ? "is-active" : "")= locale.nav.about
